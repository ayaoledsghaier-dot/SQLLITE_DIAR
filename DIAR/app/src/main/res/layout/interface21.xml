<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:text="Messages"
        android:textColor="#1E2A5A"
        android:textSize="26sp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/edtRechercheConversation"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_input_message"
        android:hint="Rechercher une conversation..."
        android:paddingHorizontal="18dp"
        android:singleLine="true"
        android:textColor="#1E2A5A"
        android:textColorHint="#94A3B8"
        android:textSize="15sp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutConversations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"/>

    </ScrollView>

    <!-- Navigation étudiant -->

    <include
        android:id="@+id/barre_navigation_etudiant"
        layout="@layout/interface_barre_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:visibility="gone"/>

    <!-- Navigation propriétaire -->

    <include
        android:id="@+id/barre_navigation_proprietaire"
        layout="@layout/interface_barre_proprietaire"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:visibility="gone"/>

</LinearLayout>
